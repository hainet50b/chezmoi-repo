{
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git -C * status:*)",
      "Bash(git diff:*)",
      "Bash(git -C * diff:*)",
      "Bash(git log:*)",
      "Bash(git -C * log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git ls-remote:*)",
      "Bash(git stash list:*)",
      "Bash(git blame:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(homeos package list:*)",
      "Bash(homeos package info:*)",
      "Bash(homeos package cat:*)",
      "Bash(homeos plugin list:*)",
      "Bash(homeos plugin list-remote:*)",
      "Bash(homeos plugin info:*)",
      "Bash(homeos plugin cat:*)",
      "Bash(homeos agents-md:*)",
      "Bash(homeos cd --print:*)",
      "Bash(homeos package cd --print:*)",
      "Bash(homeos plugin cd --print:*)",
      "Bash(cargo --version)",
      "Bash(rustc --version)",
      "Bash(git --version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(java -version)",
      "Bash(mvn -version)",
      "Bash(gradle --version)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo test:*)",
      "Bash(mvn compile:*)",
      "Bash(mvn test:*)",
      "Bash(gradle build:*)",
      "Bash(gradle test:*)",
      "Bash(gradle check:*)",
      "Bash(npm test:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:github.blog)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:blog.rust-lang.org)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:docs.oracle.com)",
      "WebFetch(domain:openjdk.org)",
      "WebFetch(domain:maven.apache.org)",
      "WebFetch(domain:docs.gradle.org)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:zed.dev)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:stackoverflow.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/.aws/**)",
      "Read(**/credentials*)"
    ],
    "_comment": {
      "ask": [
        "Edit",
        "Write",
        "NotebookEdit",
        "Bash(git commit:*)",
        "Bash(git push:*)",
        "Bash(git reset:*)",
        "Bash(git rebase:*)",
        "Bash(git clean:*)",
        "Bash(cargo run:*)",
        "Bash(cargo install:*)",
        "Bash(npm run:*)",
        "Bash(npm install:*)",
        "Bash(npm ci:*)",
        "Bash(npm start:*)",
        "Bash(npx:*)",
        "Bash(docker run:*)",
        "Bash(docker compose:*)",
        "Bash(rm:*)",
        "Bash(rmdir:*)",
        "Bash(curl:*)",
        "Bash(wget:*)"
      ]
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
